<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        O parent do Spring Boot centraliza versões compatíveis das dependências e
        configura padrões seguros para compilação, empacotamento e execução.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>br.com.academia</groupId>
    <artifactId>academia-alunos-web</artifactId>
    <version>1.0.0</version>
    <name>academia-alunos-web</name>
    <description>Sistema didático para gestão de alunos de uma academia</description>

    <properties>
        <!-- O código-fonte usa Java 21, conforme o requisito do projeto. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC, servidor embarcado e conversão automática entre Java e JSON. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistência relacional por meio de JPA e Hibernate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation para validar os dados recebidos pela API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Banco em memória usado somente durante a execução da aplicação. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Gera um JAR executável contendo o servidor web embarcado. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
